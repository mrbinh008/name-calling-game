{
  "name": "ca-xom-tron-tra-bai-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import ./tests/register-typescript.js --test --test-isolation=none tests/*.test.js",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist",
    "deploy:preview": "npm run build && wrangler pages deploy dist --branch=preview",
    "format:check": "prettier --check src tests scripts vite.config.ts playwright.config.ts tsconfig.json package.json wrangler.json README.md SPEC.md"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
